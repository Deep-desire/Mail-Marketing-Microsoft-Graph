# ── Database ──
# Supabase connection pooled URL (Transaction Mode, e.g. port 6543)
DATABASE_URL=postgresql://postgres.bnlnuetzqhvpdlchmeoy:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase direct connection URL (Session Mode, e.g. port 5432)
DIRECT_URL=postgresql://postgres.bnlnuetzqhvpdlchmeoy:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# ── Microsoft Graph API ──
MS_GRAPH_TENANT_ID=your-tenant-id-here
MS_GRAPH_CLIENT_ID=your-client-id-here
MS_GRAPH_CLIENT_SECRET=your-client-secret-here
MS_GRAPH_SENDER_EMAIL=meet@yourdomain.com

# ── Azure Communication Services (Optional Fallback) ──
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=your-access-key
AZURE_COMMUNICATION_FROM_EMAIL=donotreply@yourdomain.com

# ── App ──
FRONTEND_URL=http://localhost:5173
APP_PORT=3000

# ── Email Batch Sending Configuration
EMAIL_BATCH_SIZE=5
EMAIL_BATCH_DELAY_MS=15000
EMAIL_INDIVIDUAL_DELAY_MIN_MS=20000
EMAIL_INDIVIDUAL_DELAY_MAX_MS=30000

# Upstash QStash Configuration (Required for background scheduling on Vercel)
QSTASH_URL=""
QSTASH_TOKEN="your_qstash_token_here"
QSTASH_CURRENT_SIGNING_KEY="your_current_signing_key_here"
QSTASH_NEXT_SIGNING_KEY="your_next_signing_key_here"